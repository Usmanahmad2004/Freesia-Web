---
import bg from '../assets/freesia_background.svg';
import flower from '../assets/g11.svg';
---

<div class="flex items-center justify-center h-screen w-full">
    <main>
      <div class="relative">
        <img src={bg.src} alt="background highlight">
        <div class="absolute inset-0 flex flex-col items-center justify-center ">
            <img src = {flower.src} alt = "flower"></img>
          <h1 class="text-8xl text-white font-bold text-center">Freesia</h1>
          <h2 class="text-6xl text-white font-bold text-center">Band</h2>
        </div>
      </div>
    </main>
  </div>