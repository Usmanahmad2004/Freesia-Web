---
import bg from '../assets/freesia_background.svg';
import flower from '../assets/g11.svg';
import Island from './island.svelte';
import arrow from '../assets/arrow.svg';
import ismael from './Ismael.astro';
---

<div>
  <main>
    <!-- Load the Svelte component -->
    <Island client:load />
    
    <!-- Island Component -->
    <div id="island-component" class="fixed flex items-center justify-center h-screen w-full select-none transition-all duration-1500 ease-in-out">
      <div>
        <img src={bg.src} alt="background highlight" class= "scale-80">
      </div>
      
      <button
        id="top-left-arrow"
        class="absolute hover:scale-125 transition duration-1000 ease-in-out -translate-x-55 -translate-y-30 "
        aria-label="Navigate to section"
      >
        <img src={arrow.src} alt="Arrow" class="w-12 h-12" />
      </button>
      
      <button
        id="top-right-arrow"
        class="absolute hover:scale-125 transition duration-1000 translate-x-55 -translate-y-30 rotate-80"
        aria-label="Navigate to section"
      >
        <img src={arrow.src} alt="Arrow" class="w-12 h-12" />
      </button>
      
      <button
        id="bottom-arrow"
        class="absolute hover:scale-125 transition duration-1000 translate-y-45 rotate-220"
        aria-label="Navigate to section"
      >
        <img src={arrow.src} alt="Arrow" class="w-12 h-12" />
      </button>

       
    </div>

    
    

  </main>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    
    const islandComponent = document.getElementById('island-component');
    const bandcomp = document.querySelector('[data-island-x]');
    const arrow1 = document.getElementById('top-left-arrow');
    const arrow2 = document.getElementById('top-right-arrow');
    const arrow3 = document.getElementById('bottom-arrow');
    if (islandComponent && bandcomp) {
      
      const observer = new MutationObserver(() => {
        const x = bandcomp.getAttribute('data-island-x');
        const y = bandcomp.getAttribute('data-island-y');
        const clicked = bandcomp.getAttribute('data-clicked');
        const tag = bandcomp.getAttribute('data-tag');
        
        if (clicked === 'true') {
          islandComponent.style.transform = `translate(${x * window.innerWidth / 2}px, ${y * window.innerHeight / 2}px)`;
        } else {
          islandComponent.style.transform = 'translate(0px, 0px)';
        }

        switch(tag) {
          case '0':
            (arrow1 as HTMLElement).style.opacity = '100';
            (arrow2 as HTMLElement).style.opacity = '100';
            (arrow3 as HTMLElement).style.opacity = '100';
            break;
          case '1':
            (arrow1 as HTMLElement).style.opacity = '100';
            (arrow2 as HTMLElement).style.opacity = '0';
            (arrow3 as HTMLElement).style.opacity = '0';
            break;
          case '2':
            (arrow1 as HTMLElement).style.opacity = '0';
            (arrow2 as HTMLElement).style.opacity = '100';
            (arrow3 as HTMLElement).style.opacity = '0';
            break;
          case '3':
            (arrow1 as HTMLElement).style.opacity = '0';
            (arrow2 as HTMLElement).style.opacity = '0';
            (arrow3 as HTMLElement).style.opacity = '100';
            break;


        }

      });
      

      observer.observe(bandcomp, { attributes: true });
    }
  });
</script>