---
import bg from '../assets/freesia_background.svg';
import flower from '../assets/g11.svg';
import bandcomp from './bandcomp.svelte';
import arrow from '../assets/arrow.svg';

---

<div class="flex items-center justify-center h-screen w-full">
    <main>
      <!--LOAD SCRIPT-->
      <bandcomp client:load />


      <!--Island Component-->
      <div class="relative select-none">

        <div >
        <img src={bg.src} alt="background highlight">
        </div>



        <button 
        id="top-left-arrow"
        class="absolute hover:scale-125 transition-transform top-0.5 left-0.5"
        aria-label="Navigate to section"
        >
        <img src={arrow.src} alt="Arrow" class="w-12 h-12" />
        </button>
        
        <button 
        id="top-right-arrow"
        class="absolute hover:scale-125 transition-transform top-0.5 right-0.5 rotate-80"
        aria-label="Navigate to section"
        >
        <img src={arrow.src} alt="Arrow" class="w-12 h-12" />
        </button>

        <button 
        id="bottom-arrow"
        class="absolute hover:scale-125 transition-transform -bottom-16 left-1/2 transform -translate-x-1/2  rotate-220"
        aria-label="Navigate to section"
        >
        <img src={arrow.src} alt="Arrow" class="w-12 h-12" />
        </button>

          


        </div>

        
      </div>
    </main>
  </div>