---
import bg from '../assets/freesia_background.svg';
import flower from '../assets/g11.svg';
import LandingScript from './Scripts/LandingScript.astro';
import Island from './island.svelte';
import arrow from '../assets/arrow.svg';
import Ismael from './band-members/Ismael.astro';
import Julian from './band-members/Julian.astro';

---

<div>
  <main>
    <!-- Load the Svelte component -->
    <Island client:load />
    
    <Ismael />
    <Julian />
    <!-- Island Component -->
    <div id="island-component" class="fixed flex items-center justify-center h-screen w-full select-none transition-all duration-1500 ease-in-out">
      <div>
        <img src={bg.src} alt="background highlight" class= "scale-80">
      </div>
      
      <button
        id="top-left-arrow"
        class="absolute scale:90 hover:scale-110 transition duration-1000 ease-in-out -translate-x-55 -translate-y-30 "
        aria-label="Navigate to section"
      >
        <img src={arrow.src} alt="Arrow" class="w-12 h-12" />
      </button>
      
      <button
        id="top-right-arrow"
        class="absolute scale:90 hover:scale-110  transition duration-1000 translate-x-55 -translate-y-30 rotate-80"
        aria-label="Navigate to section"
      >
        <img src={arrow.src} alt="Arrow" class="w-12 h-12" />
      </button>
      
      <button
        id="bottom-arrow"
        class="absolute scale:90 hover:scale-110  transition duration-1000 translate-y-45 rotate-220"
        aria-label="Navigate to section"
      >
        <img src={arrow.src} alt="Arrow" class="w-12 h-12" />
      </button>

       
    </div>

    
    

  </main>
</div>

<LandingScript />